          "cachedResultName": "grocery-assistant"
        },
        "filter": "={{\n  (() => {\n    const filters = [];\n    \n    // Add filters only if they are NOT the \"ignore\" values\n    if ($json.store !== 'ALL') filters.push({ key: \"store\", match: { value: $json.store } });\n    if ($json.category !== 'ALL') filters.push({ key: \"category\", match: { value: $json.category } });\n    \n    if ($json.min_price > 0 || $json.max_price < 99999) {\n      filters.push({ key: \"total_price\", range: { gte: $json.min_price, lte: $json.max_price } });\n    }\n    \n    if ($json.start_date !== '1900-01-01' || $json.end_date !== '2099-12-31') {\n      filters.push({ key: \"purchase_date\", range: { gte: $json.start_date, lte: $json.end_date } });\n    }\n\n    // If filters exist, return the structure; otherwise, return nothing (empty object)\n    return filters.length > 0 ? JSON.stringify({ must: filters }) : undefined;\n  })()\n}}",
        "orderBy": "={{\n  ($json.sort_by && $json.sort_by !== 'NONE') ? \n  { \n    \"key\": $json.sort_by, \n    \"direction\": ($json.sort_order || \"desc\")\n  } : undefined\n}}",
        "requestOptions": {}
      },
